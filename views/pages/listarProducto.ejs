<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../sections/head'); %>
</head>

<body class="d-flex flex-column min-vh-100">
    <main class="flex-shrink-0">
        <div class="container">
            <%- include('../sections/menu'); %>
                <h1>Productos EJS</h1>
                <div class="row mt-5">
                    <div class="col-2"></div>
                    <div class="col-3">
                        <a class="btn btn-primary" href="/insertarProducto">Nuevo Producto</a>
                    </div>
                    <div class="card mt-3">
                        <div class="card-body">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre</th>
                                        <th>Marca</th>
                                        <th>Precio</th>
                                        <th>Editar</th>
                                        <th>Eliminar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% productos.forEach((producto)=> { %>
                                        <tr class="align-middle">
                                            <td>
                                                <%= producto.idProducto %>
                                            </td>
                                            <td>
                                                <%= producto.nombreProducto %>
                                            </td>
                                            <td>
                                                <%= producto.marcaProducto %>
                                            </td>
                                            <td>
                                                <%= producto.precioProducto %>
                                            </td>
                                            <td>
                                                <a href="/buscarProducto/<%= producto.idProducto %>"
                                                    class="btn btn-warning">
                                                    Editar
                                                </a>
                                            </td>
                                            <td>
                                                <a class="btn btn-danger"
                                                    href="/eliminarProducto/<%= producto.idProducto %>">
                                                    Eliminar
                                                </a>
                                            </td>
                                        </tr>
                                        <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
        </div>
    </main>
    <%- include('../sections/footer'); %>
</body>

</html>